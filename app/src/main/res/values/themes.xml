<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AppKaraoke" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.AppKaraoke.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_950</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AppKaraoke</item>
    </style>

</resources>
